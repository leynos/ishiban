{
  "name": "ishiban",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": "1.4.x"
  },
  "scripts": {
    "audit": "bun audit",
    "fmt": "biome format --write .",
    "check:fmt": "biome check --linter-enabled=false --assist-enabled=false .",
    "lint": "biome lint . && oxlint .",
    "check:types": "tsc --noEmit",
    "test": "bun test tests",
    "build": "tailwindcss -i src/styles.css -o dist/styles.css --minify && bun build src/main.tsx --outdir dist --entry-naming app.js --minify && cp src/index.html dist/index.html"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@happy-dom/global-registrator": "^21.0.4",
    "@tailwindcss/cli": "4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ai-deslop": "0.4.8",
    "bun-types": "1.4.3",
    "fast-check": "4.9.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "6.0.3",
    "zod": "4.6.6"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "daisyui": "5.7.50",
    "effect": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5"
  }
}
